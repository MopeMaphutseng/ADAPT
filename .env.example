# =============================================================================
# ADAPT TECHNOLOGIES — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Database (PostgreSQL) -------------------------------------------------
# Local user-space instance (scripts/dev-pg.sh) uses:
#   postgresql://adapt@127.0.0.1:5433/adapt_dev
# For production, use your managed PostgreSQL connection string.
DATABASE_URL="postgresql://adapt@127.0.0.1:5433/adapt_dev"

# Test database (vitest runs destructive tests here)
TEST_DATABASE_URL="postgresql://adapt@127.0.0.1:5433/adapt_test"

# --- Auth / session ----------------------------------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"

# Session cookie name (default "adapt_session")
SESSION_COOKIE="adapt_session"

# --- Admin bootstrap ----------------------------------------------------------
# Used only by `npm run db:seed` to create the initial Super Admin.
# Change these after first login from the admin dashboard.
ADMIN_EMAIL="pulamaliboho@gmail.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="Mope Samuel Maphutseng"

# --- Contact / main inbox ------------------------------------------------------
# All contact + investor inquiries are notified to this address.
CONTACT_EMAIL="pulamaliboho@gmail.com"

# --- Email (SMTP) -------------------------------------------------------------
# Optional. If left blank, emails are logged to the server console instead of sent.
# Recommended for production deployments:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
SMTP_FROM="ADAPT Technologies <noreply@example.com>"

# --- Site / SEO ----------------------------------------------------------------
# Public base URL. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional analytics activation toggle + provider script id (e.g. Plausible id)
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
NEXT_PUBLIC_ANALYTICS_DOMAIN=""

# --- Misc ----------------------------------------------------------------------
# Comma-separated list of browsers/hosts allowed to access the app (CORS not needed
# for same-origin, but kept configurable).
APP_ENV="development"
# AI Search (NVIDIA primary, with OpenRouter/Groq/OpenAI fallbacks)
SEARCH_ENABLED=true
AI_PROVIDER_ORDER=nvidia,openrouter,groq,openai

# NVIDIA (https://build.nvidia.com/)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta/llama-3.3-70b-instruct

# Groq (https://console.groq.com/)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
