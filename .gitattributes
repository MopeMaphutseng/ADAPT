# Track public media with Git LFS. YouTube-sized clips only — the 1.2 GB
# source video is intentionally excluded (see .gitignore) because it exceeds
# GitHub's 100 MB per-file limit and free LFS storage quota.
public/media/*.mp4 filter=lfs diff=lfs merge=lfs -text
public/media/*.webm filter=lfs diff=lfs merge=lfs -text
public/media/*.mov filter=lfs diff=lfs merge=lfs -text
